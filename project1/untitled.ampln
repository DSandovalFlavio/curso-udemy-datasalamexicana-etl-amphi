_id = 'cogent-tree-369319'  # <--- *** REPLACE WITH YOUR ACTUAL PROJECT ID ***\r\n\r\n# Set your BigQuery dataset ID where the table should reside\r\n# Example: dataset_id = 'my_dataset'\r\ndataset_id = 'amphi_data'  # <--- *** REPLACE WITH YOUR ACTUAL DATASET ID ***\r\n\r\n# Set the name for your target table in BigQuery\r\ntable_name = 'analisis1'\r\n\r\n# --- End Configuration ---\r\n\r\n\r\n# Construct the full destination table ID (format: project_id.dataset_id.table_name)\r\ndestination_table = f\"{project_id}.{dataset_id}.{table_name}\"\r\n\r\n# Load credentials from the specified service account JSON file\r\ncredentials = service_account.Credentials.from_service_account_file(credentials_path)\r\n\r\n# Upload the DataFrame 'input' to the specified BigQuery table\r\n# if_exists='replace': If the table already exists, it will be dropped and recreated.\r\n# Other options: 'append' (add data to existing table) or 'fail' (raise error if table exists).\r\npandas_gbq.to_gbq(\r\n    dataframe=input,\r\n    destination_table=destination_table,\r\n    project_id=project_id,\r\n    credentials=credentials,\r\n    if_exists='replace' # Choose 'replace', 'append', or 'fail' as needed\r\n)\r\n\r\n# Note: This script directly uploads the 'input' DataFrame to BigQuery.\r\n# It does not produce a new DataFrame named 'output' as the result of the operation.\r\n# The goal is achieved by executing the side effect of loading data into BigQuery.","nameId":"customOutput1","lastUpdated":0,"librariesToInstall":["pandas_gbq"],"lastExecuted":0,"successfulExecution":true},"positionAbsolute":{"x":3705,"y":-75},"width":196,"height":161,"selected":false,"dragging":false}],"edges":[{"source":"node_1742712899817","sourceHandle":"out","target":"node_1742713483965","targetHandle":"in","type":"custom-edge","id":"reactflow__edge-node_1742712899817out-node_1742713483965in"},{"source":"node_1742713483965","sourceHandle":"out","target":"node_1742713364922","targetHandle":"in","type":"custom-edge","