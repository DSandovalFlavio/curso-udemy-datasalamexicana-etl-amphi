comendable pasar las credenciales explícitamente a to_gbq\n# aunque pandas_gbq también puede usar la variable de entorno GOOGLE_APPLICATION_CREDENTIALS\ntry:\n    credentials = service_account.Credentials.from_service_account_file(credentials_path)\nexcept FileNotFoundError:\n    # Manejar el error si el archivo no se encuentra. No imprimir nada.\n    # Puedes agregar lógica de registro aquí si es necesario, pero no imprimir.\n    credentials = None # O manejar el error de otra forma silenciosa\nexcept Exception as e:\n    # Capturar otros posibles errores al cargar credenciales.\n    credentials = None\n\n\n# Definir el ID de tu proyecto y la tabla de destino en BigQuery\nproject_id = 'cogent-tree-369319' # Reemplaza con tu ID de proyecto\ndataset_id = 'amphi_data' # Reemplaza con tu ID de dataset\ntable_id = 'reporte_descuentos' # Reemplaza con el nombre de tu tabla destino\n\n# Construir el ID completo de la tabla de destino en formato 'dataset_id.table_id'\ndestination_table = f'{dataset_id}.{table_id}'\n\n# --- Carga del DataFrame a BigQuery usando pandas_gbq ---\n\n# Verificar si las credenciales se cargaron correctamente antes de proceder\nif credentials:\n    # Usar pandas_gbq.to_gbq para cargar el DataFrame\n    pandas_gbq.to_gbq(\n        dataframe=input,\n        destination_table=destination_table,\n        project_id=project_id,\n        credentials=credentials, # Pasar las credenciales cargadas\n        # 'fail': No hacer nada si la tabla existe (lanza excepción).\n        # 'replace': Borrar la tabla existente y crearla de nuevo con los datos del DataFrame.\n        # 'append': Añadir los datos del DataFrame a la tabla existente.\n        if_exists='append', # Cambia a 'append' o 'fail' según necesites\n        # progress_bar=False # Deshabilitar barra de progreso si aparece (generalmente no en scripts)\n    )\n# else:\n    # Si las credenciales no se cargaron, no se realiza ninguna acción.\n    # Puedes añadir manejo de errores silencioso aquí si es necesario.\n\n\n# El DataFrame 'output' no se genera explícitamente en este script,\n# ya que el objetivo es cargar 'input_df' a BigQuery con pandas_gbq.\n# La operación no devuelve un DataFrame.\n\n# No se imprime nada en la consola como se solicitó.","nameId":"customOutput1","lastUpdated":0,"successfulExecution":true,"lastExecuted":0,"librariesToInstall":[]},"positionAbsolute":{"x":5280,"y":-150},"width":196,"height":136,"selected":false,"dragging":false},{"id":"node_1743370254508","type":"filterColumn","position":{"x":2160,"y":120},"data":{"columns":{"sourceData":[{"value":"key_car","label":"key_car","type":"object","named":true,"key":"key_car","title":"key_car"},{"value":"Sale_Price_mean","label":"Sale_Price_mean","type":"Float64","named":true,"key":"Sale_Price_mean","title":"Sale_Price_mean"},{"value":"Date","label":"Date","type":"string","named":true,"key":"Date","title":"Date"},{"value":"Salesperson","label":"Salesperson","type":"string","named":true,"key":"Salesperson","title":"Salesperson"},{"value":"Customer Name","label":"Customer Name","type":"string","named":true,"key":"Customer Name","title":"Customer Name"},{"value":"Car Make","label":"Car Make","type":"string","named":true,"key":"Car Make","title":"Car Make"},{"value":"Car Model","label":"Car Model","type":"string","named":true,"key":"Car Model","title":"Car Model"},{"value":"Car Year","label":"Car Year","type":"string","named":true,"key":"Car Year","title":"Car Year"},{"value":"Sale Price","label":"Sale Price","type":"Int64","named":true,"key":"Sale Price","title":"Sale Price"},{"value":"Commission Rate","label":"Commission Rate","type":"Float64","named":true,"key":"Commission Rate","title":"Commission Rate"},{"value":"Commission Earned","label":"Commission Earned","type":"Float64","named":true,"key":"Commission Earned","title":"Commission Earned"},{"value":"above_mean","label":"above_mean","type":"bool","named":true,"key":"above_mean","title":"above_mean"}],"targetKeys":["Car Make"]},"nameId":"filt