a de destino en formato 'dataset_id.table_id'\ndestination_table = f'{dataset_id}.{table_id}'\n\n# --- Carga del DataFrame a BigQuery usando pandas_gbq ---\n\n# Verificar si las credenciales se cargaron correctamente antes de proceder\nif credentials:\n    # Usar pandas_gbq.to_gbq para cargar el DataFrame\n    pandas_gbq.to_gbq(\n        dataframe=input,\n        destination_table=destination_table,\n        project_id=project_id,\n        credentials=credentials, # Pasar las credenciales cargadas\n        # 'fail': No hacer nada si la tabla existe (lanza excepción).\n        # 'replace': Borrar la tabla existente y crearla de nuevo con los datos del DataFrame.\n        # 'append': Añadir los datos del DataFrame a la tabla existente.\n        if_exists='append', # Cambia a 'append' o 'fail' según necesites\n        # progress_bar=False # Deshabilitar barra de progreso si aparece (generalmente no en scripts)\n    )\n# else:\n    # Si las credenciales no se cargaron, no se realiza ninguna acción.\n    # Puedes añadir manejo de errores silencioso aquí si es necesario.\n\n\n# El DataFrame 'output' no se genera explícitamente en este script,\n# ya que el objetivo es cargar 'input_df' a BigQuery con pandas_gbq.\n# La operación no devuelve un DataFrame.\n\n# No se imprime nada en la consola como se solicitó.","nameId":"customOutput2","lastUpdated":1743371213014,"lastExecuted":1743371217990,"successfulExecution":true},"positionAbsolute":{"x":5280,"y":105},"width":196,"height":136,"selected":false,"dragging":false},{"id":"node_1743371104337","type":"customOutput","position":{"x":5280,"y":765},"data":{"code":"# Importar las librerías necesarias\nimport pandas_gbq\nimport os\n# Importar la clase Credentials para manejar la autenticación explícita (opcional pero recomendado)\nfrom google.oauth2 import service_account\n\n# --- Configuración de Autenticación y Destino ---\n# Especificar la ruta a tu archivo JSON de credenciales de la cuenta de servicio\n# Asegúrate de que la carpeta 'secretos' esté en el mismo directorio que tu script,\n# o proporciona la ruta completa.\ncredentials_filename = 'credentials.json' # Reemplaza con el nombre real de tu archivo\ncredentials_path = os.path.join('secretos', credentials_filename)\n\n# Cargar las credenciales desde el archivo JSON\n# Es recomendable pasar las credenciales explícitamente a to_gbq\n# aunque pandas_gbq también puede usar la variable de entorno GOOGLE_APPLICATION_CREDENTIALS\ntry:\n    credentials = service_account.Credentials.from_service_account_file(credentials_path)\nexcept FileNotFoundError:\n    # Manejar el error si el archivo no se encuentra. No imprimir nada.\n    # Puedes agregar lógica de registro aquí si es necesario, pero no imprimir.\n    credentials = None # O manejar el error de otra forma silenciosa\nexcept Exception as e:\n    # Capturar otros posibles errores al cargar credenciales.\n    credentials = None\n\n\n# Definir el ID de tu proyecto y la tabla de destino en BigQuery\nproject_id = 'cogent-tree-369319' # Reemplaza con tu ID de proyecto\ndataset_id = 'amphi_data' # Reemplaza con tu ID de dataset\ntable_id = 'vendedores' # Reemplaza con el nombre de tu tabla destino\n\n# Construir el ID completo de la tabla de destino en formato 'dataset_id.table_id'\ndestination_table = f'{dataset_id}.{table_id}'\n\n# --- Carga del DataFrame a BigQuery usando pandas_gbq ---\n\n# Verificar si las credenciales se cargaron correctamente antes de proceder\nif credentials:\n    # Usar pandas_gbq.to_gbq para cargar el DataFrame\n    pandas_gbq.to_gbq(\n        dataframe=input,\n        destination_table=destination_table,\n        project_id=project_id,\n        credentials=credentials, # Pasar las credenciales cargadas\n        # 'fail': No hacer nada si la tabla existe (lanza excepción).\n        # 'replace': Borrar la tabla existente y crearla de nuevo con los datos del DataFrame.\n        # 'append': Añadir los datos del DataFrame a la tabla existente.\n        if_exists='append', # Cambia a 'append' o 'fail' según necesites\n        # progress_bar=False # Deshabilitar barra de progreso si aparece (generalmente no en scripts)\n    )\n# else:\n    # Si las credenciales no se cargaron, no se realiza ninguna acción.\n    # Puedes añadir manejo de errores silencioso aquí si es necesario.\n\n\n# El DataFrame 'output' no se genera explícitamente en este script,\n# ya que el objetivo es cargar 'input_df' a BigQuery con pandas_gbq.\n# La operación no devuelve un DataFrame.\n\n# No se imprime nada en la consola como se solicitó.","nameId":"customOutput3","lastUpdated":1743371268718,"lastExecuted":1743371275194,"successfulExecution":true},"positionAbsolute":{"x":5280,"y":765},"width":196,"height":136,"selected":false,"dragging":false},{"id":"node_1743371123890","type":"customOutput","position":{"x":5280,"y":420},"data":{"code":"# Importar las librerías necesarias\nimport pandas_gbq\nimport os\n# Importar la clase Credentials para manejar la autenticación explícita (opcional pero recomendado)\nfrom google.oauth2 import service_account\n\n# --- Configuración de Autenticación y Destino ---\n# Especificar la ruta a tu archivo JSON de credenciales de la cuenta de servicio\n# Asegúrate de que la carpeta 'secretos' esté en el mismo directorio que tu script,\n# o proporciona la ruta completa.\ncredentials_filename = 'credentials.json' # Reemplaza con el nombre real de tu archivo\ncredentials_path = os.path.join('secretos', credentials_filename)\n\n# Cargar las credenciales desde el archivo JSON\n# Es recomendable pasar las credenciales explícitamente a to_gbq\n# aunque pandas_gbq también puede usar la variable de entorno GOOGLE_APPLICATION_CREDENTIALS\ntry:\n    credentials = service_account.Credentials.from_service_account_file(credentials_path)\nexcept FileNotFoundError:\n    # Manejar el error si el archivo no se encuentra. No imprimir nada.\n    # Puedes agregar lógica de registro aquí si es necesario, pero no imprimir.\n    credentials = None # O manejar el error de otra forma silenciosa\nexcept Exception as e:\n    # Capturar otros posibles errores al cargar credenciales.\n    credentials = None\n\n\n# Definir el ID de tu proyecto y la tabla de destino en BigQuery\nproject_id = 'cogent-tree-369319' # Reemplaza con tu ID de proyecto\ndataset_id = 'amphi_data' # Reemplaza con tu ID de dataset\ntable_id = 'ventas' # Reemplaza con el nombre de tu tabla destino\n\n# Construir el ID completo de la tabla de destino en formato 'dataset_id.table_id'\ndestination_table = f'{dataset_id}.{table_id}'\n\n# --- Carga del DataFrame a BigQuery usando pandas_gbq ---\n\n# Verificar si las credenciales se cargaron correctamente antes de proceder\nif credentials:\n    # Usar pandas_gbq.to_gbq para cargar el DataFrame\n    pandas_gbq.to_gbq(\n        dataframe=input,\n        destination_table=destination_table,\n        project_id=project_id,\n        credentials=credentials, # Pasar las credenciales cargadas\n        # 'fail': No hacer nada si la tabla existe (lanza excepción).\n        # 'replace': Borrar la tabla existente y crearla de nuevo con los datos del DataFrame.\n        # 'append': Añadir los datos del DataFrame a la tabla existente.\n        if_exists='append', # Cambia a 'append' o 'fail' según necesites\n        # progress_bar=False # Deshabilitar barra de progreso si aparece (generalmente no en scripts)\n    )\n# else:\n    # Si las credenciales no se cargaron, no se realiza ninguna acción.\n    # Puedes añadir manejo de errores silencioso aquí si es necesario.\n\n\n# El DataFrame 'output' no se genera explícitamente en este script,\n# ya que el objetivo es cargar 'input_df' a BigQuery con pandas_gbq.\n# La operación no devuelve un DataFrame.\n\n# No se imprime nada en la consola como se solicitó.","nameId":"customOutput4","lastUpdated":1743371240806,"successfulExecution":true,"lastExecuted":1743371256218},"positionAbsolute":{"x":5280,"y":420},"width":196,"height":136,"selected":true,"dragging":false}],"edges":[{"sourc